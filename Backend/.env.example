# Database Connection
MONGO_URI=mongodb://localhost:27017/vibefeed
# Or MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/vibefeed

# Authentication Secret
JWT_SECRET=your_jwt_secret_key_here_vibefeed_super_secret

# ImageKit Configuration (for image uploads in create post)
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key_here

# Server Port (Defaults to 3000)
PORT=3000
